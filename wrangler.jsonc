{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "untis-to-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "untis_to_api",
      "database_id": "f0b9a90f-8c89-427e-b1aa-f14323c08f93",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "untis-to-api-pdfs"
    }
  ],
  "vars": {
    "ALLOWED_SENDER": "vertretung@obs-hagen-atw.de,henry.meyer@obs-hagen-atw.de,philip.cummins@obs-hagen-atw.de",
    "ISERV_DOMAIN": "obs-hagen-atw.de",
    "EMAIL_FROM": "noreply.homelab@henrymeyer.de",
    "DEFAULT_CLASS": "9-G1",
    "SMTP_HOST": "mail.spacemail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURITY": "tls",
    "SMTP_USERNAME": "noreply.homelab@henrymeyer.de"
    "TURNSTILE_SITEKEY": "0x4AAAAAAFRmuXDndka5BrhJ"
  },
  "routes": [
    {
      "pattern": "api.grueneeule.de",
      "custom_domain": true
    },
    {
      "pattern": "obs.henrymeyer.de",
      "custom_domain": true
    }
  ]
}
